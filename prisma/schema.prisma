// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "mysql"
}

// ==========================================
// 1. ENUMS (RBAC & STATUS)
// ==========================================

enum Role {
  STUDENT
  CONSULTANT
  ADMIN_MANAGEMENT
  DOCUMENT_PROCESSOR
}

enum SessionType {
  ACADEMIC_TUTORING
  CONSULTATION
}

enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
  RESCHEDULE_REQUESTED
}

// NOTE: urutan di bawah ini (SUBMITTED -> IN_VERIFICATION -> PROCESSING_BY_ADMIN
// -> NEEDS_REVISION -> APPROVED/REJECTED) lebih logis dibanding diagram pada
// dokumen spesifikasi (yang menaruh "Submitted" di tengah alur). Perlu
// dikonfirmasi ke stakeholder istilah mana yang dipakai di UI Progress Tracker
// agar tidak membingungkan siswa.
enum DocumentStatus {
  SUBMITTED
  IN_VERIFICATION
  PROCESSING_BY_ADMIN
  NEEDS_REVISION
  APPROVED
  REJECTED
}

enum AttendanceStatus {
  ON_TIME
  LATE
  ABSENT
  LEAVE
  SICK
}

// Dipecah dari LeaveType lama (LEAVE, SICK, OVERTIME) karena dokumen
// menyebutkan 4 kategori terpisah: Izin, Sakit, Cuti, Lembur. Izin dan cuti
// digabung sebelumnya, padahal biasanya punya kuota/aturan berbeda.
enum LeaveType {
  PERMIT // Izin (ketidakhadiran singkat/personal)
  ANNUAL_LEAVE // Cuti (jatah tahunan)
  SICK
  OVERTIME
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Department {
  HR
  DOCUMENT_PROCESSING
  MANAGEMENT
}

enum NotificationChannel {
  EMAIL
  WHATSAPP
  IN_APP
}

// ==========================================
// 2. USER & AUTHENTICATION (RBAC)
// ==========================================

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  emailVerified DateTime? // wajib untuk Auth.js adapter
  passwordHash  String? // ganti jadi optional
  name          String? // jadikan optional juga, karena Google kirim "name" bukan "fullName"
  phone         String?
  role          Role      @default(STUDENT) // kasih default
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  studentProfile    StudentProfile?
  consultantProfile ConsultantProfile?
  staffProfile      StaffProfile?
  notifications     Notification[]
  announcementsMade Announcement[]   @relation("AnnouncementAuthor")

  @@map("users")
}

// ===== WAJIB untuk PrismaAdapter =====
model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model StudentProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  academicHistory String?  @db.Text
  targetProgram   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relasi permanen siswa <-> konsultan pembina ("siswa binaan").
  // Sebelumnya tidak ada; hubungan hanya bisa disimpulkan dari histori
  // Booking, yang rapuh jika siswa pernah booking ke beberapa konsultan
  // berbeda. Field ini eksplisit menjawab kebutuhan "Statistik Siswa: jumlah
  // siswa aktif dalam binaan" dan "Profil Detail Siswa binaan" di Modul 2.
  // Satu siswa hanya boleh punya SATU konsultan pembina aktif pada satu
  // waktu. Perpindahan konsultan (handover) hanya boleh dilakukan oleh role
  // ADMIN_MANAGEMENT dan tercatat di StudentConsultantHandover di bawah.
  assignedConsultantId String?
  assignedConsultant   ConsultantProfile? @relation("AssignedStudents", fields: [assignedConsultantId], references: [id])

  // Relations
  bookings     Booking[]
  documents    Document[]
  meetingNotes MeetingNote[]
  handovers    StudentConsultantHandover[]

  @@map("student_profiles")
}

model ConsultantProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeId       String   @unique // ID internal kantor untuk slip gaji, BUKAN NIK
  specialization   String?
  hourlyRate       Decimal  @default(0.00) @db.Decimal(12, 2)
  sessionIncentive Decimal  @default(0.00) @db.Decimal(12, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  assignedStudents      StudentProfile[]              @relation("AssignedStudents")
  handoversAsPrevious   StudentConsultantHandover[]    @relation("HandoverFromConsultant")
  handoversAsNew        StudentConsultantHandover[]    @relation("HandoverToConsultant")
  availabilityTemplates AvailabilityTemplate[]
  bookings              Booking[]
  meetingNotes          MeetingNote[]
  attendances           Attendance[]
  leaveRequests         LeaveRequest[]
  payslips              Payslip[] // konsultan juga menerima slip gaji (RBAC: Read Only Self)

  @@map("consultant_profiles")
}

model StaffProfile {
  id         String     @id @default(uuid())
  userId     String     @unique
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeId String     @unique // ID internal kantor untuk slip gaji, BUKAN NIK
  department Department // enum, sebelumnya String bebas -> rawan typo/variasi penulisan
  baseSalary Decimal    @default(0.00) @db.Decimal(12, 2)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  // Relations
  attendances        Attendance[]
  leaveRequests      LeaveRequest[]
  payslips           Payslip[]
  processedDocuments Document[]     @relation("ProcessedByStaff")
  approvedLeaves     LeaveRequest[] @relation("ApprovedByStaff")

  @@map("staff_profiles")
}

// ==========================================
// 3. SCHEDULING & BOOKING MODULE
// ==========================================

// Diganti namanya dari "AvailabilitySlot" -> "AvailabilityTemplate" dan field
// isBooked dihapus. Alasan: dayOfWeek + startTime/endTime menyiratkan pola
// REKURING mingguan ("setiap Senin jam 9-10"), tapi isBooked: Boolean hanya
// valid untuk SATU tanggal spesifik. Kalau setiap minggu Senin bisa dibooking
// siswa yang berbeda-beda, satu baris isBooked=true akan salah menutup semua
// Senin ke depannya. Status "terisi/tidak" sekarang dicek langsung terhadap
// tabel Booking pada tanggal aktual (startTime/endTime), bukan disimpan di sini.
model AvailabilityTemplate {
  id           String            @id @default(uuid())
  consultantId String
  consultant   ConsultantProfile @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  dayOfWeek    Int // 0 = Sunday, 1 = Monday, dst.
  startTime    String // HH:mm format, e.g., "09:00"
  endTime      String // HH:mm format, e.g., "10:00"
  isActive     Boolean           @default(true) // konsultan bisa menonaktifkan template tanpa menghapus riwayat
  createdAt    DateTime          @default(now())

  bookings Booking[]

  @@map("availability_templates")
}

model Booking {
  id             String            @id @default(uuid())
  studentId      String
  student        StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  consultantId   String
  consultant     ConsultantProfile @relation(fields: [consultantId], references: [id], onDelete: Cascade)

  // Link eksplisit ke slot ketersediaan yang "dikonsumsi" booking ini.
  // Sebelumnya tidak ada relasi ini sama sekali, sehingga validasi bahwa jam
  // booking benar-benar berada dalam jam ketersediaan konsultan harus 100%
  // ditangani di application layer tanpa jejak di database. Nullable karena
  // booking tertentu (mis. dibuat manual oleh admin) mungkin tidak berasal
  // dari template ketersediaan.
  availabilityTemplateId String?
  availabilityTemplate   AvailabilityTemplate? @relation(fields: [availabilityTemplateId], references: [id])

  sessionType    SessionType
  topic          String
  startTime      DateTime
  endTime        DateTime
  status         BookingStatus     @default(PENDING)
  cancelReason   String?
  rescheduleTime DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  // Relations
  meetingNote MeetingNote?

  // Mencegah konsultan double-booked pada rentang waktu yang identik.
  // (Overlap parsial tetap perlu dicek di application layer karena unique
  // constraint tidak bisa menangani range overlap.)
  @@unique([consultantId, startTime, endTime])
  @@map("bookings")
}

model MeetingNote {
  id              String            @id @default(uuid())
  bookingId       String            @unique
  booking         Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  studentId       String
  student         StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  consultantId    String
  consultant      ConsultantProfile @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  discussionPoint String            @db.Text
  recommendations String            @db.Text
  actionPlan      String            @db.Text
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@map("meeting_notes")
}

// Model baru: audit trail untuk perpindahan siswa dari satu konsultan
// pembina ke konsultan lain. Perubahan langsung pada
// StudentProfile.assignedConsultantId tidak menyimpan riwayat siapa yang
// mengubah, kapan, dan alasannya -- padahal aksi ini dibatasi hanya untuk
// role ADMIN_MANAGEMENT sehingga penting untuk akuntabilitas/audit.
model StudentConsultantHandover {
  id          String   @id @default(uuid())
  studentId   String
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  fromConsultantId String?
  fromConsultant    ConsultantProfile? @relation("HandoverFromConsultant", fields: [fromConsultantId], references: [id])

  toConsultantId String
  toConsultant   ConsultantProfile @relation("HandoverToConsultant", fields: [toConsultantId], references: [id])

  changedByUserId String // wajib User dengan role ADMIN_MANAGEMENT (divalidasi di application layer)
  reason          String? @db.Text
  createdAt       DateTime @default(now())

  @@map("student_consultant_handovers")
}

// ==========================================
// 4. DOCUMENT TRACKING MODULE
// ==========================================

model Document {
  id             String         @id @default(uuid())
  studentId      String
  student        StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  processedById  String?
  processedBy    StaffProfile?  @relation("ProcessedByStaff", fields: [processedById], references: [id])
  title          String // e.g., "Passport", "Transcript"
  fileUrl        String
  outcomeFileUrl String? // Document uploaded by processor
  status         DocumentStatus @default(SUBMITTED)
  revisionNote   String?        @db.Text
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // Tracking History
  history DocumentHistory[]

  @@map("documents")
}

model DocumentHistory {
  id         String         @id @default(uuid())
  documentId String
  document   Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  status     DocumentStatus
  note       String?
  updatedBy  String // User ID / Name
  createdAt  DateTime       @default(now())

  @@map("document_histories")
}

// ==========================================
// 5. ATTENDANCE & PAYROLL MODULE
// ==========================================

model Attendance {
  id           String             @id @default(uuid())
  staffId      String?
  staff        StaffProfile?      @relation(fields: [staffId], references: [id], onDelete: Cascade)
  consultantId String?
  consultant   ConsultantProfile? @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  date         DateTime           @db.Date
  clockIn      DateTime?
  clockOut     DateTime?
  status       AttendanceStatus   @default(ON_TIME)
  workHours    Decimal            @default(0.00) @db.Decimal(5, 2)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  // Mencegah duplikat presensi pada hari yang sama untuk orang yang sama.
  // Sebelumnya tidak ada constraint ini sama sekali.
  @@unique([staffId, date])
  @@unique([consultantId, date])
  @@map("attendances")
}

model LeaveRequest {
  id           String             @id @default(uuid())
  staffId      String?
  staff        StaffProfile?      @relation(fields: [staffId], references: [id], onDelete: Cascade)
  consultantId String?
  consultant   ConsultantProfile? @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  approvedById String?
  approvedBy   StaffProfile?      @relation("ApprovedByStaff", fields: [approvedById], references: [id])
  type         LeaveType
  startDate    DateTime           @db.Date
  endDate      DateTime           @db.Date
  reason       String             @db.Text
  proofFileUrl String?
  status       ApprovalStatus     @default(PENDING)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@map("leave_requests")
}

model Payslip {
  id           String             @id @default(uuid())
  // Diubah jadi nullable ganda (pola sama seperti Attendance/LeaveRequest)
  // karena RBAC matrix menyatakan Konsultan punya akses "Read Only (Self)"
  // ke modul payroll -- sebelumnya Payslip hanya bisa terhubung ke StaffProfile.
  staffId      String?
  staff        StaffProfile?      @relation(fields: [staffId], references: [id], onDelete: Cascade)
  consultantId String?
  consultant   ConsultantProfile? @relation(fields: [consultantId], references: [id], onDelete: Cascade)

  periodMonth Int // 1 - 12
  periodYear  Int // e.g., 2026

  // Snapshot identitas & employeeId pada saat slip diterbitkan. Ini
  // sengaja DIDUPLIKASI dari StaffProfile/ConsultantProfile (bukan dibaca
  // live saat render) supaya slip gaji lama tetap akurat & tidak berubah
  // meskipun nama karyawan atau employeeId di-update di kemudian hari --
  // properti penting untuk dokumen finansial yang bersifat arsip resmi.
  recipientName       String
  recipientEmployeeId String

  baseSalary       Decimal  @db.Decimal(12, 2)
  allowances       Decimal  @default(0.00) @db.Decimal(12, 2)
  sessionIncentive Decimal  @default(0.00) @db.Decimal(12, 2)
  deductions       Decimal  @default(0.00) @db.Decimal(12, 2)
  netSalary        Decimal  @db.Decimal(12, 2)
  pdfUrl           String // Encrypted PDF storage URL, berisi letterhead dari CompanySettings
  isDistributed    Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([staffId, periodMonth, periodYear])
  @@unique([consultantId, periodMonth, periodYear])
  @@map("payslips")
}

// Model baru (singleton, biasanya cuma 1 baris): identitas perusahaan yang
// dipakai sebagai letterhead di semua slip gaji (logo, nama PT, alamat).
// Dipisah dari Payslip karena datanya sama untuk semua slip -- tidak perlu
// diulang di tiap baris, dan kalau logo/alamat berubah cukup update 1 tempat.
model CompanySettings {
  id           String   @id @default(uuid())
  companyName  String
  logoUrl      String
  address      String?  @db.Text
  phone        String?
  email        String?
  updatedAt    DateTime @updatedAt

  @@map("company_settings")
}

// ==========================================
// 6. NOTIFICATIONS & ANNOUNCEMENTS
// ==========================================

// Model baru. Sebelumnya "Pengumuman Portal" dari manajemen ke banyak siswa
// harus di-insert sebagai satu baris Notification per user -> mahal untuk
// basis pengguna besar dan menyulitkan audit (siapa penulisnya, kapan
// diedit, ke role mana ditujukan). Announcement dibuat sekali oleh
// manajemen; status "sudah dibaca" tetap dilacak per-user lewat Notification.
model Announcement {
  id          String   @id @default(uuid())
  authorId    String
  author      User     @relation("AnnouncementAuthor", fields: [authorId], references: [id])
  title       String
  message     String   @db.Text
  targetRole  Role? // null = untuk semua role
  publishedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  notifications Notification[]

  @@map("announcements")
}

model Notification {
  id             String              @id @default(uuid())
  userId         String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  announcementId String?
  announcement   Announcement?       @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  title          String
  message        String              @db.Text
  isRead         Boolean             @default(false)
  channel        NotificationChannel // enum, sebelumnya String bebas -> rawan typo/variasi penulisan
  createdAt      DateTime            @default(now())

  @@map("notifications")
}
