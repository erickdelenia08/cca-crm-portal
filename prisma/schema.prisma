generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  STUDENT
  CONSULTANT
  TEACHER
  MANAGEMENT
  PROCESSING_DEPARTMENT
}

enum Department {
  HR
  DOCUMENT_PROCESSING
  MANAGEMENT
  ACADEMIC
  FINANCE
}

enum EnrollmentStatus {
  ONBOARDING
  PROCESSING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum CourseEnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum DocumentStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  REVISION_REQUIRED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum BookingSessionType {
  CONSULTATION
  FOLLOW_UP
  DOCUMENT_REVIEW
  INTERVIEW
  ORIENTATION
  OTHER
}

enum CourseLevel {
  BASIC
  INTERMEDIATE
  ADVANCED
  PREPARATION
}

enum CourseCategory {
  LANGUAGE
  ACADEMIC
  SKILL
  ORIENTATION
}

enum AttendanceStatus {
  ON_TIME
  LATE
  ABSENT
  EXCUSED
}

enum LeaveType {
  ANNUAL
  SICK
  PERSONAL
  MATERNITY
  OTHER
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  WHATSAPP
}

enum BackupStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

enum AnnouncementTargetRole {
  ALL
  STUDENT
  CONSULTANT
  TEACHER
  MANAGEMENT
  PROCESSING_DEPARTMENT
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

// ============================================================
// AUTH.JS / NEXTAUTH
// ============================================================

model User {
  id            String      @id
  name          String?
  email         String?     @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role        @default(STUDENT)
  department    Department?
  isActive      Boolean     @default(true)

  accounts Account[]
  sessions Session[]

  studentProfile    StudentProfile?
  consultantProfile ConsultantProfile?
  staffProfile      StaffProfile?

  studentEnrollments    ProgramEnrollment[] @relation("StudentEnrollments")
  consultantEnrollments ProgramEnrollment[] @relation("ConsultantEnrollments")
  documents             Document[]

  createdInvoices Invoice[] @relation("InvoiceCreatedBy")

  uploadedDocuments Document[]        @relation("DocumentUploadedBy")
  reviewedDocuments Document[]        @relation("DocumentReviewedBy")
  documentHistories DocumentHistory[] @relation("DocumentHistoryUpdatedBy")

  meetingNotes     MeetingNote[]               @relation("MeetingNoteCreatedBy")
  handoversCreated StudentConsultantHandover[] @relation("HandoverCreatedBy")

  attendances Attendance[] @relation("AttendanceRecordedBy")

  leaveRequests  LeaveRequest[] @relation("LeaveRequestedBy")
  approvedLeaves LeaveRequest[] @relation("LeaveApprovedBy")

  announcements Announcement[] @relation("AnnouncementCreatedBy")
  notifications Notification[]

  backupLogs BackupLog[] @relation("BackupTriggeredBy")

  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt
  // studentConsultantAssignments StudentConsultantAssignment[]
  // studentConsultantAssignments StudentConsultantAssignment[]
  studentAssignments    StudentConsultantAssignment[] @relation("StudentAssignments")
  consultantAssignments StudentConsultantAssignment[] @relation("ConsultantAssignments")

  @@index([role])
  @@index([department])
  @@index([isActive])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================================
// STUDENT
// ============================================================

model StudentProfile {
  id String @id @default(uuid())

  userId String @unique

  // Personal information
  studentNumber String?   @unique
  fullName      String
  email         String?
  phone         String?
  whatsapp      String?
  dateOfBirth   DateTime?
  gender        String?
  nationality   String?

  // Address
  address    String? @db.Text
  city       String?
  province   String?
  postalCode String?
  country    String?

  // Education
  educationLevel String?
  institution    String?
  major          String?
  graduationYear Int?

  // Current consultant
  assignedConsultantId String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  assignedConsultant ConsultantProfile? @relation("AssignedStudents", fields: [assignedConsultantId], references: [id], onDelete: SetNull)

  // consultantAssignments StudentConsultantAssignment[]

  // programEnrollments ProgramEnrollment[]
  courseEnrollments CourseEnrollment[]

  documents Document[]

  bookings     Booking[]
  meetingNotes MeetingNote[]

  handovers StudentConsultantHandover[] @relation("StudentHandovers")

  invoices Invoice[]

  courseAttendances CourseAttendance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assignedConsultantId])
  @@index([fullName])
  @@index([email])
  @@index([phone])
  @@map("student_profiles")
}

// ============================================================
// CONSULTANT
// ============================================================

model ConsultantProfile {
  id String @id @default(uuid())

  userId String @unique

  employeeNumber String? @unique
  fullName       String
  phone          String?
  specialization String?
  isAvailable    Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  assignedStudents StudentProfile[] @relation("AssignedStudents")

  // consultantAssignments StudentConsultantAssignment[]

  // programEnrollments ProgramEnrollment[] @relation("EnrollmentConsultant")

  bookings     Booking[]
  meetingNotes MeetingNote[]

  handoversFrom         StudentConsultantHandover[] @relation("HandoverFromConsultant")
  handoversTo           StudentConsultantHandover[] @relation("HandoverToConsultant")
  availabilityTemplates AvailabilityTemplate[]

  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  availabilityOverrides AvailabilityOverride[]

  @@index([fullName])
  @@index([isAvailable])
  @@map("consultant_profiles")
}

// ============================================================
// STAFF / TEACHER
// ============================================================

model StaffProfile {
  id String @id @default(uuid())

  userId String @unique

  employeeNumber String?     @unique
  fullName       String
  phone          String?
  position       String?
  department     Department?
  isActive       Boolean     @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  taughtClasses CourseClass[] @relation("PrimaryTeacher")

  classTeacherAssignments CourseClassTeacher[]

  attendances Attendance[] @relation("TeacherAttendance")

  leaveRequests LeaveRequest[] @relation("StaffLeaveRequests")

  payslips Payslip[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([department])
  @@index([isActive])
  @@index([fullName])
  @@map("staff_profiles")
}

// ============================================================
// PROGRAM MASTER
// ============================================================

model ProgramType {
  id String @id @default(uuid())

  name        String
  code        String  @unique
  description String? @db.Text

  isActive Boolean @default(true)

  programs Program[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@map("program_types")
}

// ============================================================
// PROGRAM
// ============================================================

model Program {
  id String @id @default(uuid())

  code String @unique
  name String

  typeId String

  destination String?

  basePrice Decimal? @db.Decimal(12, 2)

  description String? @db.Text

  isActive Boolean @default(true)

  type ProgramType @relation(fields: [typeId], references: [id])

  enrollments ProgramEnrollment[]

  documentRequirements DocumentRequirement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([typeId])
  @@index([destination])
  @@index([isActive])
  @@map("programs")
}

// ============================================================
// PROGRAM ENROLLMENT
// ============================================================

model ProgramEnrollment {
  id String @id @default(uuid())

  studentId String
  programId String

  consultantId String?

  status EnrollmentStatus @default(ONBOARDING)

  isPrimary Boolean @default(false)

  enrolledAt DateTime @default(now())

  notes String? @db.Text

  // student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  // consultant ConsultantProfile? @relation("EnrollmentConsultant", fields: [consultantId], references: [id], onDelete: SetNull)

  student    User  @relation("StudentEnrollments", fields: [studentId], references: [id], onDelete: Cascade)
  consultant User? @relation("ConsultantEnrollments", fields: [consultantId], references: [id], onDelete: SetNull)

  program Program @relation(fields: [programId], references: [id])

  documentRequirements EnrollmentDocumentRequirement[]

  documents Document[]

  invoices Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // studentProfile      StudentProfile?    @relation(fields: [studentProfileId], references: [id])
  // studentProfileId    String?
  // consultantProfile   ConsultantProfile? @relation(fields: [consultantProfileId], references: [id])
  // consultantProfileId String?

  @@index([studentId])
  @@index([programId])
  @@index([consultantId])
  @@index([status])
  @@map("program_enrollments")
}

// ============================================================
// PROGRAM DOCUMENT REQUIREMENTS
// ============================================================

model DocumentRequirement {
  id String @id @default(uuid())

  programId String

  code String
  name String

  description String? @db.Text

  isRequired Boolean @default(true)
  isActive   Boolean @default(true)

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  enrollmentRequirements EnrollmentDocumentRequirement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([programId, code])
  @@index([programId])
  @@index([isActive])
  @@map("document_requirements")
}

// ============================================================
// SNAPSHOT DOCUMENT REQUIREMENT
// ============================================================

model EnrollmentDocumentRequirement {
  id String @id @default(uuid())

  enrollmentId  String
  requirementId String?

  code String
  name String

  description String? @db.Text

  isRequired Boolean @default(true)
  isActive   Boolean @default(true)

  enrollment ProgramEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  requirement DocumentRequirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)

  documents Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([enrollmentId, code])
  @@index([enrollmentId])
  @@index([requirementId])
  @@map("enrollment_document_requirements")
}

// ============================================================
// DOCUMENT
// ============================================================

model Document {
  id String @id @default(uuid())

  enrollmentId                    String
  enrollmentDocumentRequirementId String

  studentId String

  title String

  objectKey String
  fileName  String
  mimeType  String?
  fileSize  Int?

  outcomeObjectKey String?

  status DocumentStatus @default(SUBMITTED)

  revisionNote String? @db.Text

  uploadedById String?
  reviewedById String?

  reviewedAt DateTime?

  enrollment ProgramEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  requirement EnrollmentDocumentRequirement @relation(fields: [enrollmentDocumentRequirementId], references: [id], onDelete: Cascade)

  // student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  uploadedBy User? @relation("DocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  reviewedBy User? @relation("DocumentReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  history DocumentHistory[]

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  studentProfile   StudentProfile? @relation(fields: [studentProfileId], references: [id])
  studentProfileId String?

  @@index([enrollmentId])
  @@index([enrollmentDocumentRequirementId])
  @@index([studentId])
  @@index([uploadedById])
  @@index([reviewedById])
  @@index([status])
  @@map("documents")
}

// ============================================================
// DOCUMENT HISTORY
// ============================================================

model DocumentHistory {
  id String @id @default(uuid())

  documentId String

  status DocumentStatus

  note String? @db.Text

  updatedById String

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  updatedBy User @relation("DocumentHistoryUpdatedBy", fields: [updatedById], references: [id])

  createdAt DateTime @default(now())

  @@index([documentId])
  @@index([updatedById])
  @@map("document_histories")
}

// ============================================================
// COURSE MASTER
// ============================================================

model Course {
  id String @id @default(uuid())

  code String @unique
  name String

  description String? @db.Text

  category CourseCategory?
  level    CourseLevel?

  durationHours Int?

  basePrice Decimal? @db.Decimal(12, 2)

  isActive Boolean @default(true)

  classes CourseClass[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([category])
  @@index([level])
  @@map("courses")
}

// ============================================================
// COURSE CLASS / BATCH
// ============================================================

model CourseClass {
  id String @id @default(uuid())

  courseId String

  teacherId String

  code String
  name String?

  schedule String?

  maxCapacity Int

  startDate DateTime
  endDate   DateTime

  isActive Boolean @default(true)

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  teacher StaffProfile @relation("PrimaryTeacher", fields: [teacherId], references: [id])

  teacherAssignments CourseClassTeacher[]

  enrollments CourseEnrollment[]

  sessions CourseSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, code])
  @@index([courseId])
  @@index([teacherId])
  @@index([isActive])
  @@index([startDate])
  @@index([endDate])
  @@map("course_classes")
}

// ============================================================
// COURSE CLASS TEACHER ASSIGNMENT HISTORY
// ============================================================

model CourseClassTeacher {
  id String @id @default(uuid())

  courseClassId String
  teacherId     String

  startDate DateTime
  endDate   DateTime?

  isTemporary Boolean @default(false)

  reason String? @db.Text

  courseClass CourseClass @relation(fields: [courseClassId], references: [id], onDelete: Cascade)

  teacher StaffProfile @relation(fields: [teacherId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseClassId])
  @@index([teacherId])
  @@index([startDate])
  @@index([endDate])
  @@map("course_class_teachers")
}

// ============================================================
// COURSE ENROLLMENT
// ============================================================

model CourseEnrollment {
  id String @id @default(uuid())

  studentId String

  courseClassId String

  status CourseEnrollmentStatus @default(ACTIVE)

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  notes String? @db.Text

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  courseClass CourseClass @relation(fields: [courseClassId], references: [id])

  invoices Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([courseClassId])
  @@index([status])
  @@map("course_enrollments")
}

// ============================================================
// COURSE SESSION
// ============================================================

model CourseSession {
  id String @id @default(uuid())

  courseClassId String

  title String

  startTime DateTime
  endTime   DateTime

  courseClass CourseClass @relation(fields: [courseClassId], references: [id], onDelete: Cascade)

  attendances CourseAttendance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseClassId])
  @@index([startTime])
  @@map("course_sessions")
}

// ============================================================
// COURSE ATTENDANCE
// ============================================================

model CourseAttendance {
  id String @id @default(uuid())

  sessionId String
  studentId String

  status AttendanceStatus @default(ON_TIME)

  note String? @db.Text

  session CourseSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, studentId])
  @@index([sessionId])
  @@index([studentId])
  @@map("course_attendances")
}

// ============================================================
// STUDENT ↔ CONSULTANT ASSIGNMENT HISTORY
// ============================================================

model StudentConsultantAssignment {
  id String @id @default(uuid())

  studentId    String
  consultantId String

  startDate DateTime
  endDate   DateTime?

  isTemporary Boolean @default(false)

  reason String? @db.Text

  // student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  // consultant ConsultantProfile @relation(fields: [consultantId], references: [id])

  student    User @relation("StudentAssignments", fields: [studentId], references: [id], onDelete: Cascade)
  consultant User @relation("ConsultantAssignments", fields: [consultantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([consultantId])
  @@index([startDate])
  @@index([endDate])
  @@map("student_consultant_assignments")
}

// ============================================================
// AVAILABILITY
// ============================================================

model AvailabilityTemplate {
  id String @id @default(uuid())

  consultantId String

  dayOfWeek Int

  startTime String
  endTime   String

  isActive Boolean @default(true)

  consultant ConsultantProfile @relation(fields: [consultantId], references: [id], onDelete: Cascade)

  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([consultantId])
  @@index([dayOfWeek])
  @@index([isActive])
  @@map("availability_templates")
}

model AvailabilityOverride {
  id String @id @default(uuid())

  consultantId String

  date      String // Format: YYYY-MM-DD
  startTime String
  endTime   String

  isAvailable Boolean @default(true)

  consultant ConsultantProfile @relation(fields: [consultantId], references: [id], onDelete: Cascade)

  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([consultantId])
  @@index([date])
  @@map("availability_overrides")
}

// ============================================================
// BOOKING
// ============================================================

model Booking {
  id String @id @default(uuid())

  studentId    String
  consultantId String

  availabilityTemplateId String?
  availabilityOverrideId String?

  scheduledAt     DateTime
  durationMinutes Int      @default(60)

  sessionType BookingSessionType @default(CONSULTATION)

  status BookingStatus @default(PENDING)

  meetingUrl String?

  notes String? @db.Text

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  consultant ConsultantProfile @relation(fields: [consultantId], references: [id])

  availabilityTemplate AvailabilityTemplate? @relation(fields: [availabilityTemplateId], references: [id], onDelete: SetNull)

  availabilityOverride AvailabilityOverride? @relation(fields: [availabilityOverrideId], references: [id], onDelete: SetNull)

  meetingNotes MeetingNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([consultantId])
  @@index([availabilityTemplateId])
  @@index([scheduledAt])
  @@index([status])
  @@map("bookings")
}

// ============================================================
// MEETING NOTE
// ============================================================

model MeetingNote {
  id String @id @default(uuid())

  studentId    String
  consultantId String

  bookingId String?

  title   String
  content String @db.Text

  createdById String

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  consultant ConsultantProfile @relation(fields: [consultantId], references: [id])

  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  createdBy User @relation("MeetingNoteCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([consultantId])
  @@index([bookingId])
  @@index([createdById])
  @@map("meeting_notes")
}

// ============================================================
// STUDENT CONSULTANT HANDOVER
// ============================================================

model StudentConsultantHandover {
  id String @id @default(uuid())

  studentId String

  fromConsultantId String?
  toConsultantId   String

  reason String @db.Text

  handoverDate DateTime @default(now())

  createdById String

  student StudentProfile @relation("StudentHandovers", fields: [studentId], references: [id], onDelete: Cascade)

  fromConsultant ConsultantProfile? @relation("HandoverFromConsultant", fields: [fromConsultantId], references: [id], onDelete: SetNull)

  toConsultant ConsultantProfile @relation("HandoverToConsultant", fields: [toConsultantId], references: [id])

  createdBy User @relation("HandoverCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([studentId])
  @@index([fromConsultantId])
  @@index([toConsultantId])
  @@index([createdById])
  @@index([handoverDate])
  @@map("student_consultant_handovers")
}

// ============================================================
// INVOICE
// ============================================================

model Invoice {
  id String @id @default(uuid())

  invoiceNumber String @unique

  studentId String

  programEnrollmentId String?
  courseEnrollmentId  String?

  createdById String

  subtotal       Decimal @db.Decimal(12, 2)
  taxAmount      Decimal @default(0.00) @db.Decimal(12, 2)
  discountAmount Decimal @default(0.00) @db.Decimal(12, 2)
  totalAmount    Decimal @db.Decimal(12, 2)

  status InvoiceStatus @default(DRAFT)

  dueDate DateTime
  paidAt  DateTime?

  paymentMethod String?

  pdfUrl String?

  notes String? @db.Text

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  programEnrollment ProgramEnrollment? @relation(fields: [programEnrollmentId], references: [id], onDelete: SetNull)

  courseEnrollment CourseEnrollment? @relation(fields: [courseEnrollmentId], references: [id], onDelete: SetNull)

  createdBy User @relation("InvoiceCreatedBy", fields: [createdById], references: [id])

  items InvoiceItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([programEnrollmentId])
  @@index([courseEnrollmentId])
  @@index([createdById])
  @@index([status])
  @@index([dueDate])
  @@map("invoices")
}

// ============================================================
// INVOICE ITEM
// ============================================================

model InvoiceItem {
  id String @id @default(uuid())

  invoiceId String

  description String

  quantity Decimal @default(1.00) @db.Decimal(10, 2)

  unitPrice Decimal @db.Decimal(12, 2)

  amount Decimal @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
  @@map("invoice_items")
}

// ============================================================
// GENERAL ATTENDANCE
// ============================================================

model Attendance {
  id String @id @default(uuid())

  staffId      String
  recordedById String

  date DateTime

  checkIn  DateTime?
  checkOut DateTime?

  status AttendanceStatus @default(ON_TIME)

  note String? @db.Text

  staff StaffProfile @relation("TeacherAttendance", fields: [staffId], references: [id], onDelete: Cascade)

  recordedBy User @relation("AttendanceRecordedBy", fields: [recordedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([staffId, date])
  @@index([staffId])
  @@index([recordedById])
  @@index([date])
  @@map("attendances")
}

// ============================================================
// LEAVE REQUEST
// ============================================================

model LeaveRequest {
  id String @id @default(uuid())

  staffId       String
  requestedById String

  type LeaveType

  startDate DateTime
  endDate   DateTime

  reason String? @db.Text

  status ApprovalStatus @default(PENDING)

  approvedById String?
  approvedAt   DateTime?

  staff StaffProfile @relation("StaffLeaveRequests", fields: [staffId], references: [id], onDelete: Cascade)

  requestedBy User @relation("LeaveRequestedBy", fields: [requestedById], references: [id])

  approvedBy User? @relation("LeaveApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([staffId])
  @@index([requestedById])
  @@index([approvedById])
  @@index([status])
  @@index([startDate])
  @@map("leave_requests")
}

// ============================================================
// PAYSLIP
// ============================================================

model Payslip {
  id String @id @default(uuid())

  staffId String

  periodStart DateTime
  periodEnd   DateTime

  baseSalary Decimal @db.Decimal(12, 2)
  allowances Decimal @default(0.00) @db.Decimal(12, 2)
  deductions Decimal @default(0.00) @db.Decimal(12, 2)
  netSalary  Decimal @db.Decimal(12, 2)

  pdfUrl String?

  staff StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([staffId, periodStart, periodEnd])
  @@index([staffId])
  @@index([periodStart])
  @@map("payslips")
}

// ============================================================
// COMPANY SETTINGS
// ============================================================

model CompanySettings {
  id String @id @default(uuid())

  companyName String

  email    String?
  phone    String?
  whatsapp String?

  address String? @db.Text

  logoUrl String?

  website String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("company_settings")
}

// ============================================================
// ANNOUNCEMENT
// ============================================================

model Announcement {
  id String @id @default(uuid())

  title String

  content String @db.Text

  targetRole AnnouncementTargetRole @default(ALL)

  isPublished Boolean @default(false)

  publishedAt DateTime?

  createdById String

  createdBy User @relation("AnnouncementCreatedBy", fields: [createdById], references: [id])

  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([targetRole])
  @@index([isPublished])
  @@index([publishedAt])
  @@index([createdById])
  @@map("announcements")
}

// ============================================================
// NOTIFICATION
// ============================================================

model Notification {
  id String @id @default(uuid())

  userId String

  announcementId String?

  title   String
  message String @db.Text

  channel NotificationChannel @default(IN_APP)

  isRead Boolean @default(false)

  readAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  announcement Announcement? @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([announcementId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ============================================================
// BACKUP LOG
// ============================================================

model BackupLog {
  id String @id @default(uuid())

  backupName String

  cloudStorageUrl String?
  googleDriveId   String?

  fileSizeBytes BigInt?

  status BackupStatus @default(PENDING)

  errorMessage String? @db.Text

  triggeredById String?

  triggeredBy User? @relation("BackupTriggeredBy", fields: [triggeredById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([triggeredById])
  @@index([status])
  @@index([createdAt])
  @@map("backup_logs")
}
