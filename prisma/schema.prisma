// ============================================================
// INVOICE
// ============================================================

model Invoice {
  id String @id @default(uuid())

  invoiceNumber String @unique

  clientId String

  programEnrollmentId String?

  courseEnrollmentId String?

  createdById String

  subtotal Decimal @db.Decimal(12, 2)

  taxAmount Decimal @default(0.00) @db.Decimal(12, 2)

  discountAmount Decimal @default(0.00) @db.Decimal(12, 2)

  totalAmount Decimal @db.Decimal(12, 2)

  status InvoiceStatus @default(DRAFT)

  dueDate DateTime

  paidAt DateTime?

  paymentMethod String?

  pdfUrl String?

  notes String? @db.Text

  client User @relation("ClientInvoices", fields: [clientId], references: [id], onDelete: Cascade)

  programEnrollment ProgramEnrollment? @relation(fields: [programEnrollmentId], references: [id], onDelete: SetNull)

  courseEnrollment CourseEnrollment? @relation(fields: [courseEnrollmentId], references: [id], onDelete: SetNull)

  createdBy User @relation("InvoiceCreatedBy", fields: [createdById], references: [id])

  items InvoiceItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([programEnrollmentId])
  @@index([courseEnrollmentId])
  @@index([createdById])
  @@index([status])
  @@index([dueDate])
  @@map("invoices")
}

