generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  CLIENT
  CONSULTANT
  TEACHER
  MANAGEMENT
  PROCESSING_DEPARTMENT
}

enum Department {
  HR
  DOCUMENT_PROCESSING
  MANAGEMENT
  ACADEMIC
  FINANCE
}

// ============================================================
// PROGRAM / SERVICE
// ============================================================

enum ServiceDeliveryType {
  SERVICE
  COURSE
}

enum EnrollmentStatus {
  ONBOARDING
  PROCESSING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum CourseEnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

// ============================================================
// DOCUMENT
// ============================================================

enum DocumentStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  REVISION_REQUIRED
}

// ============================================================
// BOOKING
// ============================================================

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  REJECTED
  NO_SHOW
}

enum BookingSessionType {
  CONSULTATION
  FOLLOW_UP
  DOCUMENT_REVIEW
  INTERVIEW
  ORIENTATION
  OTHER
}

// ============================================================
// COURSE
// ============================================================

enum CourseLevel {
  BASIC
  INTERMEDIATE
  ADVANCED
  PREPARATION
}

enum CourseCategory {
  LANGUAGE
  ACADEMIC
  SKILL
  ORIENTATION
}

enum CourseSessionMode {
  ONLINE
  OFFLINE
  HYBRID
}

enum AttendanceStatus {
  ON_TIME
  LATE
  ABSENT
  EXCUSED
}

enum CourseSessionOrigin {
  RECURRING
  EXTRA
  MAKEUP
}

enum MaterialType {
  DOCUMENT
  VIDEO
  LINK
  ASSIGNMENT
}

// ============================================================
// HR
// ============================================================

enum LeaveType {
  ANNUAL
  SICK
  PERSONAL
  MATERNITY
  OTHER
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// ============================================================
// SYSTEM
// ============================================================

enum NotificationChannel {
  IN_APP
  EMAIL
  WHATSAPP
}

enum BackupStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

enum AnnouncementTargetRole {
  ALL
  CLIENT
  CONSULTANT
  TEACHER
  MANAGEMENT
  PROCESSING_DEPARTMENT
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

// ============================================================
// AUTH.JS / CORE USER
// ============================================================

model User {
  id            String      @id
  name          String?
  email         String?     @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role        @default(CLIENT)
  department    Department?
  isActive      Boolean     @default(true)

  accounts Account[]
  sessions Session[]

  // ==========================================================
  // PROFILES
  // ==========================================================

  clientProfile     ClientProfile?
  consultantProfile ConsultantProfile?
  staffProfile      StaffProfile?

  // ==========================================================
  // CLIENT TRANSACTIONS
  // ==========================================================

  clientEnrollments ProgramEnrollment[] @relation("ClientEnrollments")

  consultantEnrollments ProgramEnrollment[] @relation("ConsultantEnrollments")

  courseEnrollments CourseEnrollment[] @relation("ClientCourseEnrollments")

  courseAttendances CourseAttendance[] @relation("ClientCourseAttendances")

  // ==========================================================
  // DOCUMENTS
  // ==========================================================

  clientDocuments ClientDocument[] @relation("ClientMasterDocuments")

  documents Document[] @relation("ClientDocuments")

  uploadedDocuments Document[] @relation("DocumentUploadedBy")

  reviewedDocuments Document[] @relation("DocumentReviewedBy")

  documentHistories DocumentHistory[] @relation("DocumentHistoryUpdatedBy")

  // ==========================================================
  // BOOKINGS
  // ==========================================================

  clientBookings ClientBooking[] @relation("ClientBookings")

  consultantBookings ClientBooking[] @relation("ConsultantBookings")

  // ==========================================================
  // MEETING NOTES
  // ==========================================================

  clientMeetingNotes MeetingNote[] @relation("ClientMeetingNotes")

  consultantMeetingNotes MeetingNote[] @relation("ConsultantMeetingNotes")

  createdMeetingNotes MeetingNote[] @relation("MeetingNoteCreatedBy")

  // ==========================================================
  // CONSULTANT HANDOVER / ASSIGNMENT
  // ==========================================================

  clientHandovers ClientConsultantHandover[] @relation("ClientHandovers")

  handoversFrom ClientConsultantHandover[] @relation("HandoverFromConsultant")

  handoversTo ClientConsultantHandover[] @relation("HandoverToConsultant")

  handoversCreated ClientConsultantHandover[] @relation("HandoverCreatedBy")

  clientAssignments ClientConsultantAssignment[] @relation("ClientAssignments")

  consultantAssignments ClientConsultantAssignment[] @relation("ConsultantAssignments")

  // ==========================================================
  // INVOICES
  // ==========================================================

  invoices Invoice[] @relation("ClientInvoices")

  createdInvoices Invoice[] @relation("InvoiceCreatedBy")

  // ==========================================================
  // HR
  // ==========================================================

  attendances Attendance[] @relation("AttendanceRecordedBy")

  leaveRequests LeaveRequest[] @relation("LeaveRequestedBy")

  approvedLeaves LeaveRequest[] @relation("LeaveApprovedBy")

  // ==========================================================
  // SYSTEM
  // ==========================================================

  announcements Announcement[] @relation("AnnouncementCreatedBy")

  notifications Notification[]

  availabilityTemplates AvailabilityTemplate[]

  availabilityOverrides AvailabilityOverride[]

  backupLogs BackupLog[] @relation("BackupTriggeredBy")

  uploadedMaterials CourseMaterial[] @relation("MaterialUploadedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([department])
  @@index([isActive])
  @@map("users")
}

// ============================================================
// AUTH.JS
// ============================================================

model Account {
  id                String @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String

  refresh_token String? @db.Text
  access_token  String? @db.Text
  expires_at    Int?
  token_type    String?
  scope         String?
  id_token      String? @db.Text
  session_state String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================================
// CLIENT PROFILE
// ============================================================

model ClientProfile {
  id String @id @default(uuid())

  userId String @unique

  clientNumber String? @unique

  fullName String

  email    String?
  phone    String?
  whatsapp String?

  dateOfBirth DateTime?
  gender      String?
  nationality String?

  address    String? @db.Text
  city       String?
  province   String?
  postalCode String?
  country    String?

  educationLevel String?
  institution    String?
  major          String?
  graduationYear Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fullName])
  @@index([email])
  @@index([phone])
  @@map("client_profiles")
}

// ============================================================
// CONSULTANT PROFILE
// ============================================================

model ConsultantProfile {
  id String @id @default(uuid())

  userId String @unique

  employeeNumber String? @unique

  fullName String

  phone          String?
  specialization String?

  isAvailable Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fullName])
  @@index([isAvailable])
  @@map("consultant_profiles")
}

// ============================================================
// STAFF PROFILE
// ============================================================

model StaffProfile {
  id String @id @default(uuid())

  userId String @unique

  employeeNumber String? @unique

  fullName String

  phone      String?
  position   String?
  department Department?
  isActive   Boolean     @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  taughtClasses CourseClass[] @relation("PrimaryTeacher")

  classTeacherAssignments CourseClassTeacher[]

  attendances Attendance[] @relation("TeacherAttendance")

  leaveRequests LeaveRequest[] @relation("StaffLeaveRequests")

  payslips Payslip[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([department])
  @@index([isActive])
  @@index([fullName])
  @@map("staff_profiles")
}

// ============================================================
// PROGRAM / BUSINESS LINE
// ============================================================

model Program {
  id String @id @default(uuid())

  code String @unique
  // CCABROAD
  // CCACADEMY
  // CCADVISORY

  name String

  description String? @db.Text

  isActive Boolean @default(true)

  programTypes ProgramType[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@map("programs")
}

// ============================================================
// PROGRAM TYPE / SELLABLE SERVICE
// ============================================================

model ProgramType {
  id String @id @default(uuid())

  programId String

  code String @unique
  // STUDY_OVERSEAS
  // VISITOR_VISA
  // STUDY_TOUR
  // ENGLISH_COURSE
  // MANDARIN_COURSE
  // FINANCE_PROTECTION

  name String

  description String? @db.Text

  deliveryType ServiceDeliveryType @default(SERVICE)

  isActive Boolean @default(true)

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  // Hanya digunakan apabila deliveryType = COURSE
  courses Course[]

  // Client yang membeli service ini
  enrollments ProgramEnrollment[]

  // Default document requirements
  documentRequirements DocumentRequirement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([programId])
  @@index([deliveryType])
  @@index([isActive])
  @@map("program_types")
}

// ============================================================
// PROGRAM ENROLLMENT
// ============================================================

model ProgramEnrollment {
  id String @id @default(uuid())

  clientId String

  programTypeId String

  consultantId String?

  status EnrollmentStatus @default(ONBOARDING)

  isPrimary Boolean @default(false)

  enrolledAt DateTime @default(now())

  notes String? @db.Text

  // Data khusus service.
  //
  // Contoh:
  // Study Overseas:
  // { "targetCountry": "Australia", "targetUniversity": "..." }
  //
  // Finance & Protection:
  // { "financialGoal": "...", ... }
  extendedData Json?

  client User @relation("ClientEnrollments", fields: [clientId], references: [id], onDelete: Cascade)

  consultant User? @relation("ConsultantEnrollments", fields: [consultantId], references: [id], onDelete: SetNull)

  programType ProgramType @relation(fields: [programTypeId], references: [id])

  documentRequirements EnrollmentDocumentRequirement[]

  documents Document[]

  invoices Invoice[]

  courseEnrollments CourseEnrollment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([programTypeId])
  @@index([consultantId])
  @@index([status])
  @@map("program_enrollments")
}

// ============================================================
// DOCUMENT REQUIREMENT TEMPLATE
// ============================================================
//
// Requirement default berada di level SERVICE / ProgramType.
//
// Contoh:
//
// Visitor Visa
// ├── Passport
// ├── KTP
// ├── Bank Statement
// └── Photo
//
// English Course
// └── Tidak harus punya requirement
//
// Study Tour
// ├── Passport
// └── Parent Consent
//
// ============================================================

model DocumentRequirement {
  id String @id @default(uuid())

  programTypeId String

  code String

  name String

  description String? @db.Text

  isRequired Boolean @default(true)

  isActive Boolean @default(true)

  programType ProgramType @relation(fields: [programTypeId], references: [id], onDelete: Cascade)

  enrollmentRequirements EnrollmentDocumentRequirement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([programTypeId, code])
  @@index([programTypeId])
  @@index([isActive])
  @@map("document_requirements")
}

// ============================================================
// ENROLLMENT DOCUMENT REQUIREMENT
// ============================================================
//
// Snapshot dari DocumentRequirement ketika enrollment dibuat.
//
// Jadi jika requirement service berubah di masa depan,
// enrollment lama tidak ikut berubah.
// ============================================================

model EnrollmentDocumentRequirement {
  id String @id @default(uuid())

  enrollmentId String

  requirementId String?

  code String

  name String

  description String? @db.Text

  isRequired Boolean @default(true)

  isActive Boolean @default(true)

  enrollment ProgramEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  requirement DocumentRequirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)

  documents Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([enrollmentId, code])
  @@index([enrollmentId])
  @@index([requirementId])
  @@map("enrollment_document_requirements")
}

// ============================================================
// CLIENT MASTER DOCUMENT
// ============================================================
//
// File fisik milik client.
//
// Contoh:
// Passport Erick hanya upload sekali.
// Bisa digunakan untuk beberapa enrollment.
// ============================================================

model ClientDocument {
  id String @id @default(uuid())

  clientId String

  title String

  category String?

  objectKey String

  fileName String

  mimeType String?

  fileSize Int?

  expiresAt DateTime?

  client User @relation("ClientMasterDocuments", fields: [clientId], references: [id], onDelete: Cascade)

  usages Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([category])
  @@index([expiresAt])
  @@map("client_documents")
}

// ============================================================
// DOCUMENT USAGE PER ENROLLMENT
// ============================================================

model Document {
  id String @id @default(uuid())

  enrollmentId String

  enrollmentDocumentRequirementId String

  clientId String

  clientDocumentId String?

  // Hasil proses internal.
  // Contoh:
  // translated passport
  // stamped document
  // processed document
  outcomeObjectKey String?

  status DocumentStatus @default(SUBMITTED)

  revisionNote String? @db.Text

  uploadedById String?

  reviewedById String?

  reviewedAt DateTime?

  enrollment ProgramEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  requirement EnrollmentDocumentRequirement @relation(fields: [enrollmentDocumentRequirementId], references: [id], onDelete: Cascade)

  clientDocument ClientDocument? @relation(fields: [clientDocumentId], references: [id], onDelete: SetNull)

  client User @relation("ClientDocuments", fields: [clientId], references: [id], onDelete: Cascade)

  uploadedBy User? @relation("DocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  reviewedBy User? @relation("DocumentReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  history DocumentHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Satu requirement hanya memiliki satu slot document aktif
  @@unique([enrollmentDocumentRequirementId])
  @@index([enrollmentId])
  @@index([clientDocumentId])
  @@index([clientId])
  @@index([uploadedById])
  @@index([reviewedById])
  @@index([status])
  @@map("documents")
}

// ============================================================
// DOCUMENT HISTORY
// ============================================================

model DocumentHistory {
  id String @id @default(uuid())

  documentId String

  status DocumentStatus

  note String? @db.Text

  updatedById String

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  updatedBy User @relation("DocumentHistoryUpdatedBy", fields: [updatedById], references: [id])

  createdAt DateTime @default(now())

  @@index([documentId])
  @@index([updatedById])
  @@map("document_histories")
}

// ============================================================
// COURSES
// ============================================================
//
// Hanya digunakan untuk ProgramType dengan deliveryType = COURSE.
//
// Contoh:
//
// English Course
// ├── English Basic
// ├── English Intermediate
// └── English Preparation
//
// ============================================================

model Course {
  id String @id @default(uuid())

  programTypeId String

  code String @unique

  name String

  description String? @db.Text

  category CourseCategory?

  level CourseLevel?

  durationHours Int?

  // Jumlah pertemuan standar.
  //
  // Contoh:
  // English Basic = 12 pertemuan
  //
  // CourseSession tetap menjadi sumber data
  // untuk pertemuan aktual.
  totalSessions Int?

  basePrice Decimal? @db.Decimal(12, 2)

  isActive Boolean @default(true)

  programType ProgramType @relation(fields: [programTypeId], references: [id], onDelete: Cascade)

  classes CourseClass[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([programTypeId])
  @@index([isActive])
  @@index([category])
  @@index([level])
  @@map("courses")
}

// ============================================================
// COURSE CLASS / BATCH
// ============================================================

model CourseClass {
  id String @id @default(uuid())

  courseId String

  teacherId String

  code String

  name String?

  schedule String?

  maxCapacity Int

  startDate DateTime

  endDate DateTime

  isActive Boolean @default(true)

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  teacher StaffProfile @relation("PrimaryTeacher", fields: [teacherId], references: [id])

  teacherAssignments CourseClassTeacher[]

  enrollments CourseEnrollment[]

  sessions CourseSession[]

  schedulePatterns CourseSchedulePattern[]

  materials CourseMaterial[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, code])
  @@index([courseId])
  @@index([teacherId])
  @@index([isActive])
  @@index([startDate])
  @@index([endDate])
  @@map("course_classes")
}

// ============================================================
// COURSE SCHEDULE PATTERN
// ============================================================

model CourseSchedulePattern {
  id String @id @default(uuid())

  courseClassId String

  // 0 = Sunday
  // 1 = Monday
  // ...
  // 6 = Saturday
  dayOfWeek Int

  startTime String

  endTime String

  defaultMode CourseSessionMode @default(OFFLINE)

  defaultLocation String?

  isActive Boolean @default(true)

  courseClass CourseClass @relation(fields: [courseClassId], references: [id], onDelete: Cascade)

  sessions CourseSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseClassId])
  @@index([isActive])
  @@map("course_schedule_patterns")
}

// ============================================================
// COURSE CLASS TEACHER
// ============================================================

model CourseClassTeacher {
  id String @id @default(uuid())

  courseClassId String

  teacherId String

  startDate DateTime

  endDate DateTime?

  isTemporary Boolean @default(false)

  reason String? @db.Text

  courseClass CourseClass @relation(fields: [courseClassId], references: [id], onDelete: Cascade)

  teacher StaffProfile @relation(fields: [teacherId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseClassId])
  @@index([teacherId])
  @@index([startDate])
  @@index([endDate])
  @@map("course_class_teachers")
}

// ============================================================
// COURSE ENROLLMENT
// ============================================================
//
// CourseEnrollment menunjukkan client masuk ke CourseClass.
//
// ProgramEnrollment menjadi enrollment utama atas service.
// ============================================================

model CourseEnrollment {
  id String @id @default(uuid())

  clientId String

  courseClassId String

  programEnrollmentId String

  status CourseEnrollmentStatus @default(ACTIVE)

  startedAt DateTime @default(now())

  endedAt DateTime?

  notes String? @db.Text

  client User @relation("ClientCourseEnrollments", fields: [clientId], references: [id], onDelete: Cascade)

  courseClass CourseClass @relation(fields: [courseClassId], references: [id])

  programEnrollment ProgramEnrollment @relation(fields: [programEnrollmentId], references: [id], onDelete: Cascade)

  invoices Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([courseClassId])
  @@index([programEnrollmentId])
  @@index([status])
  @@map("course_enrollments")
}

// ============================================================
// COURSE SESSION
// ============================================================
//
// Satu record = satu pertemuan aktual.
// ============================================================

model CourseSession {
  id String @id @default(uuid())

  courseClassId String

  // Null untuk EXTRA / MAKEUP
  patternId String?

  origin CourseSessionOrigin @default(RECURRING)

  title String

  startTime DateTime

  endTime DateTime

  mode CourseSessionMode @default(OFFLINE)

  meetingUrl String?

  location String?

  courseClass CourseClass @relation(fields: [courseClassId], references: [id], onDelete: Cascade)

  pattern CourseSchedulePattern? @relation(fields: [patternId], references: [id], onDelete: SetNull)

  attendances CourseAttendance[]

  materials CourseMaterial[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseClassId])
  @@index([patternId])
  @@index([startTime])
  @@index([origin])
  @@map("course_sessions")
}

// ============================================================
// COURSE ATTENDANCE
// ============================================================

model CourseAttendance {
  id String @id @default(uuid())

  sessionId String

  clientId String

  status AttendanceStatus @default(ON_TIME)

  note String? @db.Text

  attachmentUrl String?

  session CourseSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  client User @relation("ClientCourseAttendances", fields: [clientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, clientId])
  @@index([sessionId])
  @@index([clientId])
  @@map("course_attendances")
}

// ============================================================
// COURSE MATERIAL
// ============================================================

model CourseMaterial {
  id String @id @default(uuid())

  courseClassId String

  sessionId String?

  title String

  description String? @db.Text

  type MaterialType @default(DOCUMENT)

  objectKey String?

  fileName String?

  mimeType String?

  fileSize Int?

  externalUrl String?

  isVisibleToClient Boolean @default(true)

  uploadedById String

  courseClass CourseClass @relation(fields: [courseClassId], references: [id], onDelete: Cascade)

  session CourseSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  uploadedBy User @relation("MaterialUploadedBy", fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseClassId])
  @@index([sessionId])
  @@index([type])
  @@index([isVisibleToClient])
  @@map("course_materials")
}

// ============================================================
// CONSULTANT ASSIGNMENT HISTORY
// ============================================================

model ClientConsultantAssignment {
  id String @id @default(uuid())

  clientId String

  consultantId String

  startDate DateTime

  endDate DateTime?

  isTemporary Boolean @default(false)

  reason String? @db.Text

  client User @relation("ClientAssignments", fields: [clientId], references: [id], onDelete: Cascade)

  consultant User @relation("ConsultantAssignments", fields: [consultantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([consultantId])
  @@index([startDate])
  @@index([endDate])
  @@map("client_consultant_assignments")
}

// ============================================================
// AVAILABILITY
// ============================================================

model AvailabilityTemplate {
  id String @id @default(uuid())

  consultantId String

  dayOfWeek Int

  startTime String

  endTime String

  isActive Boolean @default(true)

  consultant User @relation(fields: [consultantId], references: [id], onDelete: Cascade)

  bookings ClientBooking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([consultantId])
  @@index([dayOfWeek])
  @@index([isActive])
  @@map("availability_templates")
}

model AvailabilityOverride {
  id String @id @default(uuid())

  consultantId String

  date String
  // YYYY-MM-DD

  startTime String

  endTime String

  isAvailable Boolean @default(true)

  consultant User @relation(fields: [consultantId], references: [id], onDelete: Cascade)

  bookings ClientBooking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([consultantId])
  @@index([date])
  @@map("availability_overrides")
}

// ============================================================
// BOOKING
// ============================================================

model ClientBooking {
  id String @id @default(uuid())

  clientId String

  consultantId String

  availabilityTemplateId String?

  availabilityOverrideId String?

  scheduledAt DateTime

  durationMinutes Int @default(60)

  sessionType BookingSessionType @default(CONSULTATION)

  status BookingStatus @default(PENDING)

  meetingUrl String?

  notes String? @db.Text

  client User @relation("ClientBookings", fields: [clientId], references: [id], onDelete: Cascade)

  consultant User @relation("ConsultantBookings", fields: [consultantId], references: [id], onDelete: Cascade)

  availabilityTemplate AvailabilityTemplate? @relation(fields: [availabilityTemplateId], references: [id], onDelete: SetNull)

  availabilityOverride AvailabilityOverride? @relation(fields: [availabilityOverrideId], references: [id], onDelete: SetNull)

  meetingNotes MeetingNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([consultantId])
  @@index([availabilityTemplateId])
  @@index([availabilityOverrideId])
  @@index([scheduledAt])
  @@index([status])
  @@map("bookings")
}

